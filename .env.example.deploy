# Copy this file to `.env` on the VPS (gitignored) and fill in the values.
# Used by `docker compose` — never commit the real .env.

# Required: long random secret shared by API (signs) and game-server (verifies).
# Generate: openssl rand -hex 32
JWT_SECRET=please-set-a-long-random-secret

# Public hostname/IP your players will connect to. Used by the built web client
# as the WebSocket endpoint. Example: VITE_SERVER_URL=ws://203.0.113.10/ws
VITE_SERVER_URL=ws://localhost/ws

# Browser origin(s) allowed to call the API. Set to your public host/IP, e.g.
# http://203.0.113.10  (multiple origins: comma-separated).
ALLOWED_ORIGINS=http://localhost

# Reject tokenless joins (default on in production — keep it on).
REQUIRE_AUTH=1

# ---- Database (Postgres credentials for the stack) ----
POSTGRES_USER=deashot
POSTGRES_PASSWORD=please-set-a-strong-db-password
POSTGRES_DB=deashot

# ---- Redis (optional; unset for single-instance in-memory presence) ----
# REDIS_URL=redis://redis:6379

# ---- Sentry (optional; unset to disable error reporting) ----
# SENTRY_DSN=https://public@ingest.sentry.io/project
