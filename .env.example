# Shared between the API (signs guest JWTs) and the game server (verifies them).
# Required whenever NODE_ENV=production — both services refuse to start without
# it rather than fall back to the development default, which is public in this
# repository. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-prod

# API
DATABASE_URL=postgres://deashot:deashot@localhost:5432/deashot
REDIS_URL=redis://localhost:6379

# Game server
PORT=2567

# Reject clients that join without an auth token. Defaults on when
# NODE_ENV=production; set to 0 there only to deliberately allow anonymous play.
REQUIRE_AUTH=0

# Honour match tuning (killLimit, duration, warmupPlayers, warmupSeconds) sent
# in the client's joinOrCreate payload. Used by the integration harness for
# deterministic runs. Ignored when NODE_ENV=production — with it on, any client
# could open a room with killLimit=1.
ALLOW_TEST_ROOM_OPTIONS=0

# Web (Vite)
VITE_SERVER_URL=ws://localhost:2567
VITE_API_URL=http://localhost:4000
