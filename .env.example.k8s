# Kubernetes Secret/ConfigMap template for Deashot.
#
# Copy this file to `.env` ON THE VM (gitignored) and fill in real values.
# Then run:  ./scripts/setup-secrets.sh
# This script injects the values into the k8s Secret + ConfigMap.
# The real values are NEVER committed to git.

# ---- Secret values (go into k8s Secret `deashot-secrets`) ----
# Required. Generate:  openssl rand -hex 32
DEASHOT_SECRET_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Required. Generate:  openssl rand -hex 24
DEASHOT_SECRET_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Redis connection string (or empty to disable Redis presence)
DEASHOT_SECRET_REDIS_URL=redis://redis-service:6379

# Browser origin(s) allowed to call the API, e.g. http://203.0.113.10
DEASHOT_SECRET_ALLOWED_ORIGINS=http://localhost

# Sentry DSN (optional, leave empty to disable)
DEASHOT_SECRET_SENTRY_DSN=

# ---- Registry auth (used to create the imagePullSecret) ----
# Identity of the registry the cluster pulls from. For an anonymous/local
# registry set DEASHOT_REGISTRY to its URL and leave username/password empty.
DEASHOT_REGISTRY=
DEASHOT_REGISTRY_USERNAME=
DEASHOT_REGISTRY_PASSWORD=

# ---- Config values (go into k8s ConfigMap `deashot-config`) ----
DEASHOT_CONFIG_NODE_ENV=production
DEASHOT_CONFIG_PORT_API=4000
DEASHOT_CONFIG_PORT_GAME=2567
DEASHOT_CONFIG_REQUIRE_AUTH=1
DEASHOT_CONFIG_ALLOW_TEST_ROOM_OPTIONS=0
DEASHOT_CONFIG_POSTGRES_USER=deashot
DEASHOT_CONFIG_POSTGRES_DB=deashot
DEASHOT_CONFIG_VITE_API_URL=/api
# Public WebSocket URL players use. http(s)://your-public-host/ws
DEASHOT_CONFIG_VITE_SERVER_URL=ws://localhost/ws
